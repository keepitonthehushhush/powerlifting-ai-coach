{
  "name": "powerlifting-ai-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI strength coach that programs, adjusts, and progresses powerlifters over time.",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/dev.js",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "node --test \"server/test/*.test.js\"",
    "verify:bundle": "node scripts/scan-bundle-for-secrets.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:db": "node scripts/run-sql-test.mjs supabase/tests/rls_isolation_test.sql",
    "safety:eval": "node scripts/safety-eval.mjs",
    "verify:deps": "node scripts/verify-frontend-deps.mjs",
    "verify": "npm run verify:deps && npm run verify:bundle",
    "check": "npm test && npm run verify:deps && npm run build && npm run verify:bundle",
    "check:db": "node scripts/check-db-invariants.mjs",
    "test:db:psql": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_isolation_test.sql",
    "check:contact": "node scripts/check-contact-route.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^10.71.0"
  }
}
