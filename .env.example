# =============================================================================
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The split below is the whole security model in miniature:
#   VITE_*  is compiled into the browser bundle and is PUBLIC by definition.
#   Everything else is server-only and must never gain a VITE_ prefix.
# =============================================================================

# --- Server-only. Never expose to the browser. -------------------------------
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Model ID kept in config so swapping models is a deploy variable, not a commit.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# Supabase URL is not secret, but the server reads its own copy so the API can
# run without the frontend's build-time variables being present.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# THE SERVICE-ROLE KEY. It bypasses row-level security completely - anything
# holding it can read and write every athlete's profile, programme, logs and
# health restrictions. It must never appear in a VITE_ variable, in the
# browser bundle, in a log line, or in a commit.
#
# Needed only for billing. A Stripe webhook arrives with no user and no JWT,
# and the subscription mirror is deliberately not writable by any client,
# because a client that could write it could grant itself a subscription. See
# ADR-12 and lib/supabaseAdmin.js, which is the only file that imports it.
#
# Leave it EMPTY unless you are running billing. config.stripe.enabled counts
# it as one of the four things billing requires, so an empty value switches
# billing off rather than leaving a deployment that can charge a card and not
# record the subscription.
#
# Dashboard > Settings > API Keys. Prefer the `sb_secret_...` key; the legacy
# `service_role` JWT still works and is the same privilege.
SUPABASE_SECRET_KEY=

# --- Browser-visible. Safe to ship; both are designed to be public. ----------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local dev only. In production the API is same-origin and this stays unset.
VITE_API_BASE_URL=http://localhost:3001

# --- Optional: error monitoring ----------------------------------------------
# Leave unset to run without Sentry. When set, every event passes through the
# same redactor the logger uses, so health data cannot reach the tracker.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Optional: billing. Leave ALL of these unset to run the free product. -----
#
# The app boots fine without them - logging, charts, the library and the policy
# pages are free, and only the coaching conversation sits behind the paywall.
# `enabled` is derived from all three of SECRET_KEY, WEBHOOK_SECRET and PRICE_ID
# being present, because a secret key with no webhook secret is the dangerous
# half-configured state: checkout would work and the thing that grants access
# would not.
#
# USE TEST KEYS (sk_test_...) FOR DEVELOPMENT. A live key here charges real
# cards. config.js exposes stripe.livemode so a startup check can tell.
#
# Dashboard > Developers > API keys (toggle "Test mode" on first)
STRIPE_SECRET_KEY=sk_test_...
# Dashboard > Developers > Webhooks > your endpoint > "Signing secret".
# Locally: `stripe listen --forward-to localhost:3001/api/billing/webhook`
# prints one that starts whsec_ and lasts for that session.
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard > Product catalogue > your $9.99/month recurring price > the id
# under the price, not the product id. Starts price_, not prod_.
STRIPE_PRICE_ID=price_...
# Where Stripe sends people back to after they finish in the billing portal.
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/account

# DOES THE PAYWALL ACTUALLY APPLY? Separate from the keys above on purpose.
#
# Setting the Stripe keys means "we can take money". This means "coaching
# conversations now require a subscription". They are different decisions and
# you want to make the first one, test checkout end to end, and only then make
# the second.
#
# Leave it false. Turning it true is a product decision with a public promise
# attached: the FAQ currently says the product is free while it is being built
# and tested, and that sentence has to change in the same commit. A test in
# server/test/paywall.test.js fails if it does not.
#
# With no Stripe configuration this does nothing except log an error - a
# paywall with no way to pay is a locked door with no handle, so the app keeps
# everyone on the free product.
PAYWALL_ENABLED=false
