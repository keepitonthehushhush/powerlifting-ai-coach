# ---- Secrets. Never commit these. -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---- Dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---- Build output -----------------------------------------------------------
dist/
build/
.vercel/
*.local

# ---- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-error.log*

# ---- Editor / OS ------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- Test / coverage --------------------------------------------------------
coverage/
.nyc_output/

# ---- Generated eval output --------------------------------------------------
# Regenerated on every run and different each time, since model output is not
# deterministic. Findings that matter are written up in docs/BUILD_LOG.md
# instead, where they can be read without re-running anything.
safety-eval-results.txt
